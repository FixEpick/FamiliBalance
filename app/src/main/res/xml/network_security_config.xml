<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Запрет cleartext (HTTP) для всего приложения: только HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
