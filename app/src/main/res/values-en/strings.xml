    <!-- Rules sheet -->
    <string name="rules_title">📜 Rules scroll</string>
    <string name="rules_offline">No internet? Don\'t worry! All your quests and rewards are saved on the phone. As soon as the network is back, they\'ll be sent to the cloud automatically.</string>
    <string name="rules_balance_title">📖 How your balance works</string>
    <string name="rules_balance_text">All earned rubles go to your wallet. You can exchange them for phone time (100 ₽ = 30 minutes) OR you can withdraw all your money at any time — take your whole balance as real paper money from dad!</string>
    <string name="rules_earn_title">💰 How to earn:</string>
    <string name="rules_earn_text">• Grade "5" in diary: +50 ₽\n• Grade "4" in diary: +30 ₽\n• Wardrobe photo (perfect order): +%1$d ₽\n• Room photo (made bed and tidiness): +%2$d ₽\n• Achievement bonuses: from 10 ₽ to 500 ₽ for the "Server Legend" rank!</string>
    <string name="rules_penalty_title">🔴 What costs you money (Penalties)</string>
    <string name="rules_penalty_text">Grade "3" costs -20 ₽, grade "2" costs -50 ₽. But if you lied or hid the truth and then honestly told dad through the kitty — dad will approve the admission and halve the penalty for that offense! (down to -10 ₽ for a three and -25 ₽ for a two).</string>
    <string name="rules_streak_title">🔥 Days without penalties</string>
    <string name="rules_streak_text">Check in every day and get +50 ₽ every 7 days without penalties! But any penalty burns all accumulated days — and each missed day extinguishes one flame.</string>
    <string name="rules_screentime_title">⏳ Screen time</string>
    <string name="rules_screentime_text">Limit 90 minutes per day. Tariffs: 30 min = 100 ₽, 60 min = 200 ₽, 90 min = 300 ₽.</string>
    <string name="rules_honest_title">🐱 Honest admission</string>
    <string name="rules_honest_text">50% discount on one penalty. Available once every 7 days — tell dad the truth through the kitty!</string>
    <string name="rules_diary_title">📓 Diary</string>
    <string name="rules_diary_text">Submitted once a week. Grades: 5 (+50 ₽), 4 (+30 ₽), 3 (-20 ₽), 2 (-50 ₽).</string>
    <string name="rules_achievements_title">🏆 Achievements</string>
    <string name="rules_achievements_text">Earn bonuses for new ranks from 10 ₽ to 500 ₽ for the "Server Legend" rank!</string>
    <string name="rules_understood">Got it!</string>

